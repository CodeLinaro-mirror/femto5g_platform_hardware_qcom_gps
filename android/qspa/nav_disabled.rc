service loc_launcher /vendor/bin/loc_launcher
    override
    class late_start
    user gps
    group gps
    disabled

service xtra-daemon /vendor/bin/xtra-daemon
    override
    class late_start
    user gps
    group inet diag gps system radio logd
    disabled

