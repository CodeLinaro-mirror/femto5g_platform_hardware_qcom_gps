package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
     name: "car_aidl_power_libs_cc_defaults",
     module_type: "cc_defaults",
     config_namespace: "ANDROID",
     bool_variables: ["IS_ANDROID_VER_U"],
     properties: ["shared_libs"],
}

car_aidl_power_libs_cc_defaults {
  name: "car_aidl_power_libs_defaults",
  soong_config_variables: {
     IS_ANDROID_VER_U: {
         shared_libs: ["android.frameworks.automotive.powerpolicy-V2-ndk",],
         conditions_default: {
             shared_libs: ["android.frameworks.automotive.powerpolicy-V3-ndk",],
         },
     },
  }
}

cc_defaults {
    name: "gnss_car_aidl_powerpolicy",
      defaults: [
         "car_aidl_power_libs_defaults",
      ],

    cflags: [
        "-Wall",
        "-Wno-missing-field-initializers",
        "-Werror",
        "-Wno-unused-variable",
        "-Wunused-parameter",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
        "libutils",
        "libbinder_ndk",
        "libpowerpolicyclient",
    ],
}

cc_library_shared {
    name: "libgnss_car_aidl_powerpolicy",
    vendor: true,
    srcs: [
        "src/GnssCarAidlPowerHandler.cpp",
    ],

    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
        "libloc_pla_headers",
        "vhal_v2_0_common_headers",
        "liblocation_api_headers",
    ],

    shared_libs: [
        "liblog",
        "libhidlbase",
        "libcutils",
        "libutils",
        "libgps.utils",
        "liblocation_api",
        "android.hardware.gnss@1.0",
        "libbase",
    ],

    defaults: [
        "gnss_car_aidl_powerpolicy",
    ],
    export_include_dirs: ["include"],
}
