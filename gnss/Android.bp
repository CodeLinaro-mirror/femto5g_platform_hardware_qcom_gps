

cc_library_shared {

    name: "libgnss",
    defaults: ["qtilocation_common_defaults"],
    vendor: true,

    shared_libs: [
        "libutils",
        "libcutils",
        "libdl",
        "liblog",
        "libloc_core",
        "libgps.utils",
        "liblocation_api",
    ],

    srcs: [
        "location_gnss.cpp",
        "GnssAdapter.cpp",
        "Agps.cpp",
        "XtraSystemStatusObserver.cpp",
        "NativeAgpsHandler.cpp",
        "GnssAutoStartSessionClient.cpp",
        "GnssAutoStartSession.cpp",
    ],

    cflags: ["-fno-short-enums"] + GNSS_CFLAGS + ["-DFEATURE_AUTO_SESSION"],
    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
    ],

}
